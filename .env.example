# Copia este archivo como .env (raiz) para las credenciales locales de Docker
# Y backend/.env para la clave del LLM (ver backend/.env.example si existe)

NEO4J_USER=neo4j
NEO4J_PASSWORD=cambia-esta-clave-local

# En backend/.env:
# GEMINI_API_KEY=tu_clave
# GEMINI_MODEL=gemini-3.6-flash
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/gcal/callback
# FRONTEND_URL=http://localhost:3000
# GCAL_TIMEZONE=America/Bogota
